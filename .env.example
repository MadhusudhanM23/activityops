# ---- ActivityOps environment. No real secrets in this file. ----
# Copy to .env for local development. In production these come from AWS Secrets
# Manager via deploy/fetch-secrets.sh - never commit a real value.

NODE_ENV=development
PORT=8787                      # dev default; 8080 collides with a local service (D-026). Containers use 8080.
HOST=127.0.0.1                 # containers bind 0.0.0.0
DATABASE_PATH=./data/activityops.sqlite
# WEB_DIST_PATH=../web/dist    # set in production; in development Vite serves the frontend

# Sign-in. One login in this build (spec sec. 14).
DEMO_USERNAME=demo.operator
# Development falls back to a fixed dev-only password. In production the server
# REFUSES TO START unless this is set to 12+ characters that are not the dev value.
DEMO_PASSWORD=
SESSION_IDLE_MINUTES=720
# COOKIE_SECURE=true           # defaults to true in production (HTTPS via Caddy)
# TRUST_PROXY=true             # defaults to true in production (behind Caddy)

# Ring - server-side only, never exposed to the browser. The access token is NOT
# configured here: operators paste a short-lived Playground token in the app,
# and it is held in memory only.
RING_API_BASE_URL=https://api.amazonvision.com

# Matching model (spec sec. 8). PROVISIONAL: Day-1 T5 could not measure provider
# indexing delay (device offline), so these are unmeasured defaults.
CLOCK_SKEW_ALLOWANCE_SECONDS=30
SESSION_WINDOW_SECONDS=600
DEMO_SESSION_WINDOW_SECONDS=300
POST_WINDOW_OBSERVATION_MARGIN_SECONDS=60
HISTORY_PAGE_CAP=10

# AWS / Bedrock. The model id is configuration - do NOT assume Claude is
# available (spec sec. 17). Leave unset until Day-1 T9 confirms access.
AWS_REGION=
BEDROCK_MODEL_ID=
