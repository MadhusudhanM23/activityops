# ---- ActivityOps environment (no real secrets in this file) ----
NODE_ENV=development
PORT=8080
HOST=127.0.0.1   # containers bind 0.0.0.0; local dev binds loopback
APP_BASE_URL=http://localhost:5173

# Session / CSRF
SESSION_SECRET=replace-with-32+-random-chars
COOKIE_SECURE=false

# SQLite (authoritative store; on EC2 this path lives on the encrypted EBS mount)
DATABASE_PATH=./data/activityops.sqlite

# Ring (server-side only; NEVER exposed to the browser)
RING_API_BASE_URL=
RING_PLAYGROUND_TOKEN=
# Matching model (spec sec. 8)
CLOCK_SKEW_ALLOWANCE_SECONDS=30
SESSION_WINDOW_SECONDS=600
DEMO_SESSION_WINDOW_SECONDS=300
POST_WINDOW_OBSERVATION_MARGIN_SECONDS=60
HISTORY_PAGE_CAP=10

# AWS / Bedrock (model id is configuration - do NOT assume Claude is available)
AWS_REGION=
BEDROCK_MODEL_ID=
